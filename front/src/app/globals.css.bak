@import "tailwindcss";

/* ═══════════════════════════════════════════
   SmartTube Design System — "The Digital Scholar"
   Based on Stitch project #15134210677760320479
   ═══════════════════════════════════════════ */

:root {
  /* ── Foundation Surfaces (Tonal Layering) ── */
  --surface-lowest: #0e0e0e;
  --surface-dim: #131313;
  --surface: #131313;
  --surface-low: #1c1b1b;
  --surface-container: #201f1f;
  --surface-high: #2a2a2a;
  --surface-highest: #353534;
  --surface-bright: #3a3939;

  /* ── Primary (Action / Brand) ── */
  --primary: #ffb4a8;
  --primary-container: #ff5540;
  --on-primary: #690100;
  --on-primary-container: #5c0000;
  --primary-fixed: #ffdad4;
  --primary-fixed-dim: #ffb4a8;

  /* ── Secondary (Supporting) ── */
  --secondary: #c8c6c5;
  --secondary-container: #474746;
  --on-secondary: #303030;
  --on-secondary-container: #b6b5b4;

  /* ── Tertiary (Accent) ── */
  --tertiary: #acc7ff;
  --tertiary-container: #488fff;

  /* ── Error ── */
  --error: #ffb4ab;
  --error-container: #93000a;

  /* ── Neutrals ── */
  --on-surface: #e5e2e1;
  --on-surface-variant: #ebbbb4;
  --outline: #b18780;
  --outline-variant: #603e39;
  --inverse-surface: #e5e2e1;
  --inverse-on-surface: #313030;
  --inverse-primary: #c00100;

  /* ── Foreground / Background aliases ── */
  --background: #0b0b0d;
  --foreground: #e5e2e1;
}

/* ── Tailwind v4 Theme Tokens ── */
@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --color-surface-lowest: var(--surface-lowest);
  --color-surface-dim: var(--surface-dim);
  --color-surface: var(--surface);
  --color-surface-low: var(--surface-low);
  --color-surface-container: var(--surface-container);
  --color-surface-high: var(--surface-high);
  --color-surface-highest: var(--surface-highest);
  --color-surface-bright: var(--surface-bright);

  --color-primary: var(--primary);
  --color-primary-container: var(--primary-container);
  --color-on-primary: var(--on-primary);
  --color-on-primary-container: var(--on-primary-container);

  --color-secondary: var(--secondary);
  --color-secondary-container: var(--secondary-container);
  --color-on-secondary: var(--on-secondary);
  --color-on-secondary-container: var(--on-secondary-container);

  --color-tertiary: var(--tertiary);
  --color-tertiary-container: var(--tertiary-container);

  --color-error: var(--error);
  --color-error-container: var(--error-container);

  --color-on-surface: var(--on-surface);
  --color-on-surface-variant: var(--on-surface-variant);
  --color-outline: var(--outline);
  --color-outline-variant: var(--outline-variant);

  --font-sans: var(--font-inter), system-ui, -apple-system, sans-serif;

  /* Animation tokens */
  --animate-fade-in: fade-in 0.6s ease-out both;
  --animate-fade-up: fade-up 0.7s ease-out both;
  --animate-slide-up: slide-up 0.5s ease-out both;
  --animate-glow-pulse: glow-pulse 3s ease-in-out infinite;
  --animate-float: float 6s ease-in-out infinite;
}

/* ── Animation Keyframes ── */
@keyframes fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(24px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes glow-pulse {

  0%,
  100% {
    opacity: 0.6;
  }

  50% {
    opacity: 1;
  }
}

@keyframes float {

  0%,
  100% {
    transform: translateY(0px);
  }

  50% {
    transform: translateY(-8px);
  }
}

/* ── Base Styles ── */
body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-inter), system-ui, sans-serif;
}

/* ── Glassmorphism Utility ── */
.glass {
  background: rgba(42, 42, 42, 0.45);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.glass-subtle {
  background: rgba(32, 31, 31, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* ── Ghost Border (accessibility boundary without visual clutter) ── */
.ghost-border {
  box-shadow: inset 0 0 0 1px rgba(96, 62, 57, 0.15);
}

.ghost-border-active {
  box-shadow: inset 0 0 0 1px rgba(255, 180, 168, 0.4);
}

/* ── Ambient Shadow (diffused, not muddy) ── */
.ambient-shadow {
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
}

.ambient-shadow-sm {
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
}

/* ── Primary Gradient (CTA glow) ── */
.gradient-primary {
  background: linear-gradient(135deg, #ffb4a8, #ff5540);
}

.glass-panel {
  background: rgba(32, 31, 31, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.hero-gradient {
  background: radial-gradient(circle at 50% 50%, rgba(255, 180, 168, 0.05) 0%, rgba(19, 19, 19, 0) 70%);
}

.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

.gradient-primary-text {
  background: linear-gradient(135deg, #ffbeb7, #ff7c70);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Typography scale (editorial) ── */
.text-display {
  font-size: 4.5rem;
  line-height: 1.02;
  letter-spacing: -0.025em;
  font-weight: 800;
}

.text-headline {
  font-size: 2rem;
  line-height: 1.15;
  letter-spacing: -0.015em;
  font-weight: 700;
}

.text-label {
  font-size: 0.6875rem;
  line-height: 1.4;
  letter-spacing: 0.08em;
  font-weight: 600;
  text-transform: uppercase;
}

/* ── Smooth scroll ── */
html {
  scroll-behavior: smooth;
}

/* ── Selection ── */
::selection {
  background: rgba(255, 85, 64, 0.3);
  color: #fff;
}

/* ── Scrollbar ── */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: var(--surface-lowest);
}

::-webkit-scrollbar-thumb {
  background: var(--surface-highest);
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--outline);
}
