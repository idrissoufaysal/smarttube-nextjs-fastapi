datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

model User {
  id           String        @id @default(uuid())
  clerkId      String        @unique // Clerk User ID (user_xxx)
  email        String        @unique
  firstName    String?
  lastName     String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  videos       Video[]
  quizAttempts QuizAttempt[]
  chatMessages ChatMessage[]
}

model Video {
  id           String        @id // YouTube Video ID (e.g. dQw4w9WgXcQ)
  title        String
  description  String?
  thumbnail    String?
  author       String?
  duration     Int // in seconds
  transcript   String        @db.Text
  notes        String?       @db.Text
  userId       String? // FK vers User (optionnel pour rétro-compat)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  segments     Segment[]
  quizzes      Quiz[]
  attempts     QuizAttempt[]
  chatMessages ChatMessage[]

  @@index([userId])
}

model Segment {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  start     Float // offset in seconds
  duration  Float // duration in seconds
  createdAt DateTime @default(now())

  @@index([videoId])
}

model Quiz {
  id         String         @id @default(uuid())
  videoId    String
  video      Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  difficulty String // 'facile', 'moyen', 'difficile'
  createdAt  DateTime       @default(now())
  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  @@index([videoId])
}

model QuizQuestion {
  id                 String   @id @default(uuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question           String   @db.Text
  options            String[] // Choice options (array supported natively in PG)
  correctAnswerIndex Int
  explanation        String   @db.Text

  @@index([quizId])
}

model QuizAttempt {
  id         String   @id @default(uuid())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId     String? // FK vers User
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  score      Int
  total      Int
  difficulty String // 'facile', 'moyen', 'difficile'
  createdAt  DateTime @default(now())

  @@index([videoId])
  @@index([quizId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String? // FK vers User
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      String // 'user', 'assistant', 'system'
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([videoId])
  @@index([userId])
  @@index([createdAt])
}
