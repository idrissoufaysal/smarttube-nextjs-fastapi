# ==============================================================================
# SMARTTUBE FRONTEND - CONFIGURATION D'ENVIRONNEMENT (.env.local)
# ==============================================================================
# Copiez ce fichier vers 'front/.env.local' :
#   cp front/.env.example front/.env.local
# Remplissez ensuite vos clés ci-dessous.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BACKEND FASTAPI
# ------------------------------------------------------------------------------
# URL de votre serveur FastAPI (doit inclure /api à la fin)
# En local : http://localhost:8000/api
# En production : https://votre-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api


# ------------------------------------------------------------------------------
# 2. AUTHENTIFICATION CLERK
# ------------------------------------------------------------------------------
# Récupérez ces clés sur votre tableau de bord Clerk (https://dashboard.clerk.com/)
# dans la section "API Keys".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
