# FastAPI & App Settings
PROJECT_NAME="SmartTube API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","https://votre-frontend.vercel.app"]

# PostgreSQL Database (Neon / Supabase / Render / Insforge)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# AI & LLM Providers (OpenRouter / OpenAI)
AI_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small

# Reranking (OpenRouter /rerank — cohere/rerank-4-fast)
HYBRID_ALPHA=0.75
RERANK_MODEL=cohere/rerank-4-fast
RERANK_CANDIDATES=10
RERANK_TOP_N=3

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX=smarttubes
PINECONE_NAMESPACE_DEFAULT=transcripts

# Services tiers
SUPADATA_API_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Langfuse (LLM Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
