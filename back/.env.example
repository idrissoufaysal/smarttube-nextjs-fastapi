# FastAPI & App Settings
PROJECT_NAME="SmartTube API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","https://votre-frontend.vercel.app"]

# PostgreSQL Database (Neon / Supabase / Render / Insforge)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# AI & LLM Providers (OpenRouter / OpenAI)
AI_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.5-flash

# Embeddings (Perplexity Embeddings API — pplx-embed-v1-0.6b, 1024 dims)
# pplx-embed n'est PAS dispo sur OpenRouter → clé Perplexity dédiée :
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
EMBEDDING_MODEL=pplx-embed-v1-0.6b
EMBEDDING_DIMENSIONS=1024

# Reranking (OpenRouter /rerank — cohere/rerank-4-fast)
RERANK_MODEL=cohere/rerank-4-fast
RERANK_CANDIDATES=15
RERANK_TOP_N=5

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX=smarttube
PINECONE_NAMESPACE_DEFAULT=transcripts

# Services tiers
SUPADATA_API_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Langfuse (LLM Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
