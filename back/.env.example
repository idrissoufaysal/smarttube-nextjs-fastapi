# ==============================================================================
# SMARTTUBE BACKEND - CONFIGURATION D'ENVIRONNEMENT (.env)
# ==============================================================================
# Copiez ce fichier vers 'back/.env' :
#   cp back/.env.example back/.env
# Remplissez ensuite vos clés d'API ci-dessous.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RÉSEAU (CORS)
# ------------------------------------------------------------------------------
PROJECT_NAME="SmartTube API"
ENVIRONMENT=development  # 'development' ou 'production'

# Origines autorisées pour communiquer avec le backend (Frontend Next.js)
# En local : http://localhost:3000
# En production : ["https://votre-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]


# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL (Obligatoire)
# ------------------------------------------------------------------------------
# Compatible avec Neon Cloud (recommandé), Supabase, Render Postgres ou PostgreSQL local.
# Si vous utilisez Neon, gardez 'sslmode=require'.
DATABASE_URL=postgresql://votre_utilisateur:votre_mot_de_passe@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require


# ------------------------------------------------------------------------------
# 3. INTELLIGENCE ARTIFICIELLE & LLM (Obligatoire)
# ------------------------------------------------------------------------------
# Clé d'API principale pour la génération (Gemini ou OpenRouter).
# Obtenez une clé gratuite sur https://aistudio.google.com/ ou https://openrouter.ai/
AI_KEY=votre_cle_api_ici

# Modèle utilisé pour la génération des résumés, quiz et chat
OPENROUTER_MODEL=google/gemini-2.5-flash

# Modèle pour les embeddings vectoriels (OpenAI / OpenRouter - 1536 dimensions)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optionnel si vous utilisez OpenAI directement au lieu de OpenRouter / Google
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ------------------------------------------------------------------------------
# 4. RAG HYBRIDE & RERANKING
# ------------------------------------------------------------------------------
HYBRID_ALPHA=0.75         # 0.75 = 75% sémantique dense, 25% mots-clés BM25 (recommandé Pinecone)
RERANK_MODEL=cohere/rerank-4-fast
RERANK_CANDIDATES=10      # Nombre de candidats initiaux récupérés dans Pinecone
RERANK_TOP_N=3            # Nombre de chunks ultra-pertinents conservés pour le prompt


# ------------------------------------------------------------------------------
# 5. BASE VECTORIELLE PINECONE (Obligatoire pour le RAG)
# ------------------------------------------------------------------------------
# Créez un compte gratuit sur https://www.pinecone.io/
# Créez un index Serverless nommé 'smarttubes' avec :
#   - Dimension : 1536
#   - Metric : cosine
PINECONE_API_KEY=votre_cle_pinecone_ici
PINECONE_INDEX=smarttubes
PINECONE_NAMESPACE_DEFAULT=transcripts


# ------------------------------------------------------------------------------
# 6. AUTHENTIFICATION CLERK (Obligatoire)
# ------------------------------------------------------------------------------
# Récupérez vos clés sur https://dashboard.clerk.com/ -> API Keys
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...


# ------------------------------------------------------------------------------
# 7. TRANSCRIPTION YOUTUBE (Optionnel / Fallback)
# ------------------------------------------------------------------------------
# Service de secours si l'API YouTube native bloque les requêtes.
# Obtenez une clé sur https://supadata.ai/ (gratuit pour démarrer)
SUPADATA_API_KEY=


# ------------------------------------------------------------------------------
# 8. OBSERVABILITÉ LLM - LANGFUSE (Optionnel)
# ------------------------------------------------------------------------------
# Pour monitorer la latence, les coûts et la qualité des prompts LLM.
# Obtenez vos clés gratuites sur https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
