# 1. APPLICATION & RÉSEAU (CORS)
PROJECT_NAME="SmartTube API"
ENVIRONMENT=development  # 'development' ou 'production'

# Origines autorisées pour communiquer avec le backend (Frontend Next.js)
# En local : http://localhost:3000
# En production : ["https://votre-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000",]


# 2. BASE DE DONNÉES POSTGRESQL (Obligatoire)

DATABASE_URL=


# 3. INTELLIGENCE ARTIFICIELLE & LLM (Obligatoire)

# Clé d'API principale pour la génération (OpenRouter).
AI_KEY=votre_cle_api_ici

# Modèle utilisé pour la génération des résumés, quiz et chat
OPENROUTER_MODEL=google/gemini-2.5-flash

# Modèle pour les embeddings vectoriels (OpenAI / OpenRouter - 1536 dimensions)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optionnel si vous utilisez OpenAI directement au lieu de OpenRouter / Google
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini



PINECONE_API_KEY=votre_cle_pinecone_ici
PINECONE_INDEX=smarttubes
PINECONE_NAMESPACE_DEFAULT=transcripts


# 6. AUTHENTIFICATION CLERK (Obligatoire)
# Récupérez vos clés sur https://dashboard.clerk.com/ -> API Keys
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...


# 7. TRANSCRIPTION YOUTUBE (Optionnel / Fallback)
# Obtenez une clé sur https://supadata.ai/ (gratuit pour démarrer)
SUPADATA_API_KEY=


# ------------------------------------------------------------------------------
# 8. OBSERVABILITÉ LLM - LANGFUSE (Optionnel)
# ------------------------------------------------------------------------------
# Pour monitorer la latence, les coûts et la qualité des prompts LLM.
# Obtenez vos clés gratuites sur https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
